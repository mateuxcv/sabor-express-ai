# demo: respostas automáticas locais. crewai: serviço Python + modelo real.
# Sugestões manuais de resposta e transcrição de áudio usam Azure nos dois modos.
ASSISTANT_PROVIDER=demo
CREWAI_SERVICE_URL=http://127.0.0.1:8000
CREWAI_SERVICE_TOKEN=

# Monitor preventivo: no modo crewai, usa Azure para analisar o contexto.
# Em demo ou false, usa regras. O serviço Python persiste os alertas nos dois modos.
SENTIMENT_USE_LLM=true

# Azure Foundry — configuração compartilhada com o serviço Python.
# Copie este arquivo para .env na raiz do projeto.
AZURE_ENDPOINT=
AZURE_API_KEY=
# Nome exato do deployment, sem prefixo azure/ ou openai/.
AZURE_MODEL=

# inference: https://RECURSO.services.ai.azure.com/models
# openai_v1: https://RECURSO.openai.azure.com/openai/v1/
AZURE_API_MODE=inference
# Somente inference; confira a versão no exemplo do portal.
AZURE_API_VERSION=2024-05-01-preview

# Deployment de transcrição de voz, separado do modelo de chat.
AZURE_AUDIO_DEPLOYMENT=
# Em branco, reutilizam AZURE_ENDPOINT e AZURE_API_KEY.
AZURE_AUDIO_ENDPOINT=
# true para usar explicitamente a chave do chat no mesmo recurso Azure.
AZURE_AUDIO_USE_CHAT_KEY=false
AZURE_AUDIO_API_KEY=
AZURE_AUDIO_LANGUAGE=pt
AZURE_AUDIO_API_VERSION=2025-04-01-preview

CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true

# Ligações WebRTC no Azure Foundry — nome exato da implantação Realtime.
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_REALTIME_ENDPOINT=
AZURE_REALTIME_USE_CHAT_KEY=true
AZURE_REALTIME_API_KEY=
AZURE_REALTIME_VOICE=marin
AZURE_REALTIME_TRANSCRIPTION_MODEL=whisper-1
AZURE_REALTIME_MAX_SECONDS=300

# RD Station CRM v2 — credenciais de aplicativo do produto CRM.
RD_CRM_CLIENT_ID=
RD_CRM_CLIENT_SECRET=
RD_CRM_REDIRECT_URI=http://localhost:3000/api/crm/callback
# markdown: títulos, negrito e listas. text: mesmo conteúdo sem sintaxe Markdown.
# A API recebe texto; a renderização do Markdown depende da interface do RD.
RD_CRM_TEXT_FORMAT=markdown
